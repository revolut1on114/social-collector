# Скопіюйте в .env і змініть за потреби. .env у git НЕ потрапляє.
LOG_LEVEL=INFO
LOG_FORMAT=text            # json | text (у файл data/logs/collector.log завжди пишеться JSON)

# Стрічки: instance:tag|account|public:value, через кому.
# Увага: частина інстансів (напр. infosec.exchange) закрила анонімний доступ до стрічок хештегів —
# відповідає 422 "This method requires an authenticated user". Для таких потрібен токен у MASTODON_TOKENS.
MASTODON_TARGETS=mastodon.social:tag:osint,mastodon.social:tag:ukraine,mstdn.social:account:bellingcat

# Токени необов'язкові (публічні стрічки читаються анонімно).
# Кілька токенів на інстанс через | — ротація, ліміт ділиться між акаунтами.
# Створити: Налаштування → Розробка → Новий застосунок, scope read:statuses
MASTODON_TOKENS=
# MASTODON_TOKENS=mastodon.social=tokenA|tokenB,infosec.exchange=tokenC

# Партія за прогін
PAGE_LIMIT=40              # статусів за запит (максимум API — 40)
MAX_PAGES_PER_TARGET=5     # сторінок на стрічку за інкрементний прогін
BACKFILL_PAGES=10          # сторінок назад за один backfill

# Ліміти
REQUEST_DELAY_S=1.0        # пауза між запитами до одного інстансу (не менше 0.5)
MAX_RETRIES=5
BACKOFF_BASE_S=2
BACKOFF_MAX_S=300
RATELIMIT_LOW_REMAINING=20 # нижче цього X-RateLimit-Remaining — розтягуємо запити до Reset
HTTP_TIMEOUT_S=20

# Проксі (бонус), напр. http://user:pass@host:3128 або socks5h://127.0.0.1:9050
COLLECTOR_PROXY=

# Режим loop (docker compose)
LOOP_INTERVAL_S=900
